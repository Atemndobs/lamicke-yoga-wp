# =============================================================================
# Lamicke Yoga WP→Wix Migration — local environment
# Copy this file to .env and fill in the values from the secure handoff email.
# =============================================================================

# ---- WordPress source (live site, read-only access) -------------------------
WP_SITE_URL=https://lamickeyoga.com
WP_ADMIN_USER=atemkeng

# Prefer an Application Password for authenticated REST/WP-CLI actions.
# Generate it at: /wp-admin/profile.php > "Application Passwords"
WP_APP_PASSWORD=

# Fallback only (often fails for authenticated REST calls on modern WordPress):
WP_ADMIN_PASSWORD=

# ---- Wix target site --------------------------------------------------------
# These are stable, safe to keep here.
WIX_SITE_ID=6ee22a84-e12b-4725-a9c4-a148e56ef212
WIX_SITE_NAME=Lamicke Yoga
WIX_HTML_APP_ID=aaf57183-6d7d-4141-8553-bbde35dd1f14

# ---- Heavy artifact download URLs (sent by email — links may expire) --------
# These two files are NOT committed to git. Paste the URLs from the handoff
# email, then run `scripts/setup/download-heavy-files.ps1` (Windows PowerShell)
# or `scripts/setup/download-heavy-files.sh` (macOS/Linux).
WP_SITE_BACKUP_URL=
WP_DB_BACKUP_URL=
